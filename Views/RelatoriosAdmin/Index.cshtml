@model BarberFlow.ViewModels.Relatorios.RelatorioReservasViewModel
@using BarberFlow.Enums
@{ ViewData["Title"] = "Relatórios"; }
<section class="container py-5">
    <div class="admin-page-header mb-4"><div><span class="eyebrow">RELATÓRIOS</span><h1 class="mt-2">Reservas e resultados</h1><p class="text-secondary mb-0">Filtre os atendimentos e acompanhe os valores do período.</p></div><a asp-controller="Admin" asp-action="Index" class="btn btn-outline-brand">Voltar ao dashboard</a></div>
    <form method="get" class="form-card mb-4">
        <div class="row g-3 align-items-end">
            <div class="col-md-2"><label asp-for="DataInicial" class="form-label">Data inicial</label><input asp-for="DataInicial" type="date" class="form-control" /></div>
            <div class="col-md-2"><label asp-for="DataFinal" class="form-label">Data final</label><input asp-for="DataFinal" type="date" class="form-control" /></div>
            <div class="col-md-3"><label asp-for="ProfissionalId" class="form-label">Profissional</label><select asp-for="ProfissionalId" asp-items="Model.Profissionais" class="form-select"><option value="">Todos</option></select></div>
            <div class="col-md-2"><label asp-for="ServicoId" class="form-label">Serviço</label><select asp-for="ServicoId" asp-items="Model.Servicos" class="form-select"><option value="">Todos</option></select></div>
            <div class="col-md-2"><label asp-for="Status" class="form-label">Status</label><select asp-for="Status" asp-items="Html.GetEnumSelectList<StatusReserva>()" class="form-select"><option value="">Todos</option></select></div>
            <div class="col-md-1 d-grid"><button class="btn btn-accent">Filtrar</button></div>
        </div>
        <div class="mt-3"><a asp-action="Index" class="back-link">Limpar filtros</a></div>
    </form>
    <div class="report-summary mb-4">
        <div><span>Registros</span><strong>@Model.TotalRegistros</strong></div>
        <div><span>Faturamento realizado</span><strong>@Model.ValorTotal.ToString("C")</strong></div>
        <div><span>Faturamento previsto</span><strong>@Model.ValorPrevisto.ToString("C")</strong></div>
    </div>
    <div class="table-card">
        @if (Model.Reservas.Any())
        {<div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Data</th><th>Cliente</th><th>Profissional</th><th>Serviço</th><th>Valor</th><th>Status</th></tr></thead><tbody>
        @foreach (var r in Model.Reservas)
        {<tr><td>@r.DataHoraInicio.ToString("dd/MM/yyyy HH:mm")</td><td>@r.Cliente.Nome</td><td>@r.Profissional.Nome</td><td>@r.Servico.Nome</td><td>@r.Servico.Preco.ToString("C")</td><td><span class="status-pill status-@r.Status.ToString().ToLower()">@r.Status</span></td></tr>}
        </tbody></table></div>}
        else {<div class="empty-panel">Nenhum resultado encontrado para os filtros informados.</div>}
    </div>
</section>
