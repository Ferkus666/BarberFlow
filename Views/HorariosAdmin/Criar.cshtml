@model BarberFlow.ViewModels.Profissionais.HorarioTrabalhoViewModel
@{
    ViewData["Title"] = "Adicionar horário";
}
<div class="container py-5"><div class="form-shell mx-auto">
    <a class="back-link" asp-action="Index" asp-route-profissionalId="@Model.ProfissionalId">← Voltar para agenda</a>
    <div class="form-card mt-3">
        <span class="eyebrow text-dark">Disponibilidade</span><h1 class="h2 fw-bold mt-2">Adicionar horário</h1><p class="text-muted">Profissional: <strong>@Model.ProfissionalNome</strong></p>
        <form method="post">
            <input asp-for="ProfissionalId" type="hidden" /><input asp-for="ProfissionalNome" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <div class="mb-3"><label asp-for="DiaSemana" class="form-label"></label><select asp-for="DiaSemana" class="form-select"><option value="1">Segunda-feira</option><option value="2">Terça-feira</option><option value="3">Quarta-feira</option><option value="4">Quinta-feira</option><option value="5">Sexta-feira</option><option value="6">Sábado</option><option value="0">Domingo</option></select></div>
            <div class="row g-3 mb-4"><div class="col-md-6"><label asp-for="HoraInicio" class="form-label"></label><input asp-for="HoraInicio" type="time" class="form-control" /><span asp-validation-for="HoraInicio" class="text-danger"></span></div><div class="col-md-6"><label asp-for="HoraFim" class="form-label"></label><input asp-for="HoraFim" type="time" class="form-control" /><span asp-validation-for="HoraFim" class="text-danger"></span></div></div>
            <div class="d-flex justify-content-end gap-2"><a class="btn btn-light" asp-action="Index" asp-route-profissionalId="@Model.ProfissionalId">Cancelar</a><button class="btn btn-accent px-4">Adicionar período</button></div>
        </form>
    </div>
</div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
