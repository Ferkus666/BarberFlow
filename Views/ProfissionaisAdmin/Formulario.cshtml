@model BarberFlow.ViewModels.Profissionais.ProfissionalFormViewModel
@{
    var edicao = Model.Id > 0;
    ViewData["Title"] = edicao ? "Editar profissional" : "Novo profissional";
}
<div class="container py-5">
    <div class="form-shell mx-auto">
        <a class="back-link" asp-action="Index">← Voltar para profissionais</a>
        <div class="form-card mt-3">
            <span class="eyebrow text-dark">Equipe</span>
            <h1 class="h2 fw-bold mt-2">@(edicao ? "Editar profissional" : "Cadastrar profissional")</h1>
            <p class="text-muted">Defina os dados do barbeiro e quais serviços ele está habilitado a realizar.</p>
            <form asp-action="@(edicao ? "Editar" : "Criar")" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">
                <input asp-for="Id" type="hidden" />
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <div class="mb-3">
                    <label asp-for="Nome" class="form-label"></label>
                    <input asp-for="Nome" class="form-control" />
                    <span asp-validation-for="Nome" class="text-danger"></span>
                </div>
                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="Especialidade" class="form-label"></label>
                        <input asp-for="Especialidade" class="form-control" placeholder="Ex.: Especialista em fade e barba" />
                        <span asp-validation-for="Especialidade" class="text-danger"></span>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="AnosExperiencia" class="form-label"></label>
                        <input asp-for="AnosExperiencia" class="form-control" min="0" max="60" />
                        <span asp-validation-for="AnosExperiencia" class="text-danger"></span>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="Instagram" class="form-label"></label>
                        <div class="input-group"><span class="input-group-text">@@</span><input asp-for="Instagram" class="form-control" placeholder="usuario" /></div>
                        <span asp-validation-for="Instagram" class="text-danger"></span>
                    </div>
                </div>
                <div class="mb-4">
                    <label asp-for="Biografia" class="form-label"></label>
                    <textarea asp-for="Biografia" class="form-control" rows="4" placeholder="Especialidades, experiência e estilo de atendimento"></textarea>
                    <span asp-validation-for="Biografia" class="text-danger"></span>
                </div>
                <div class="mb-4">
                    <label asp-for="Foto" class="form-label"></label>
                    <div class="photo-upload-panel">
                        @if (!string.IsNullOrWhiteSpace(Model.FotoUrlAtual))
                        {
                            <img src="@Model.FotoUrlAtual" alt="Foto atual" class="admin-photo-preview" />
                        }
                        <div class="flex-grow-1">
                            <input asp-for="Foto" class="form-control" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" />
                            <div class="form-text">JPG, PNG ou WEBP, até 3 MB. Ao enviar uma nova foto, a anterior é substituída.</div>
                            <span asp-validation-for="Foto" class="text-danger"></span>
                        </div>
                    </div>
                </div>
                <div class="row g-3 mb-4">
                    <div class="col-md-7">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control" placeholder="profissional@barberflow.local" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                    <div class="col-md-5">
                        <label asp-for="Senha" class="form-label"></label>
                        <input asp-for="Senha" class="form-control" placeholder="@(Model.Id == 0 ? "Obrigatória no cadastro" : "Deixe vazio para manter")" />
                        <span asp-validation-for="Senha" class="text-danger"></span>
                    </div>
                </div>
                <div class="mb-4">
                    <label class="form-label fw-semibold">Serviços realizados</label>
                    <div class="selection-grid">
                        @foreach (var servico in Model.ServicosDisponiveis)
                        {
                            <label class="check-card">
                                <input type="checkbox" name="ServicosSelecionados" value="@servico.Value" checked="@servico.Selected" />
                                <span>@servico.Text</span>
                            </label>
                        }
                    </div>
                    @if (!Model.ServicosDisponiveis.Any()) { <p class="small text-muted mt-2">Cadastre ou ative serviços antes de vincular um profissional.</p> }
                </div>
                <div class="form-check form-switch mb-4">
                    <input asp-for="Ativo" class="form-check-input" />
                    <label asp-for="Ativo" class="form-check-label"></label>
                </div>
                <div class="d-flex gap-2 justify-content-end">
                    <a class="btn btn-light" asp-action="Index">Cancelar</a>
                    <button class="btn btn-accent px-4" type="submit">Salvar profissional</button>
                </div>
            </form>
        </div>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
