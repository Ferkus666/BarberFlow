@model BarberFlow.ViewModels.Conta.RegistroViewModel
@{
    ViewData["Title"] = "Criar conta";
}
<div class="auth-page">
    <div class="container py-5">
        <div class="auth-card mx-auto">
            <div class="mb-4">
                <span class="eyebrow text-dark">Novo cliente</span>
                <h1 class="h2 fw-bold mt-2">Crie sua conta</h1>
                <p class="text-muted">Seu cadastro será associado ao perfil Cliente.</p>
            </div>
            <form asp-action="Registro" method="post" novalidate>
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <div class="mb-3">
                    <label asp-for="Nome" class="form-label"></label>
                    <input asp-for="Nome" class="form-control" autocomplete="name" />
                    <span asp-validation-for="Nome" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-control" autocomplete="email" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="Senha" class="form-label"></label>
                        <input asp-for="Senha" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="Senha" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="ConfirmarSenha" class="form-label"></label>
                        <input asp-for="ConfirmarSenha" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="ConfirmarSenha" class="text-danger"></span>
                    </div>
                </div>
                <p class="small text-muted mt-3">Use pelo menos 6 caracteres, com letra maiúscula, minúscula e número.</p>
                <button class="btn btn-accent w-100 py-2 mt-2" type="submit">Criar conta</button>
            </form>
            <p class="text-center mt-4 mb-0">Já possui conta? <a asp-action="Login">Entrar</a></p>
        </div>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
