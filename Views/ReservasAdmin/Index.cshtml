@model BarberFlow.ViewModels.Reservas.ReservaFiltroViewModel
@using BarberFlow.Enums
@{ ViewData["Title"] = "Gestão de reservas"; }
<section class="container py-5">
    <div class="admin-page-header mb-4"><div><span class="eyebrow">ADMINISTRAÇÃO</span><h1 class="mt-2">Gestão de reservas</h1><p class="text-secondary mb-0">Consulte os atendimentos por data, profissional, serviço ou status.</p></div></div>
    <div class="form-card mb-4">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-lg-3"><label asp-for="Data" class="form-label">Data</label><input asp-for="Data" class="form-control" /></div>
            <div class="col-lg-3"><label asp-for="ProfissionalId" class="form-label">Profissional</label><select asp-for="ProfissionalId" asp-items="Model.Profissionais" class="form-select"><option value="">Todos</option></select></div>
            <div class="col-lg-3"><label asp-for="ServicoId" class="form-label">Serviço</label><select asp-for="ServicoId" asp-items="Model.Servicos" class="form-select"><option value="">Todos</option></select></div>
            <div class="col-lg-2"><label asp-for="Status" class="form-label">Status</label><select asp-for="Status" asp-items="Html.GetEnumSelectList<StatusReserva>()" class="form-select"><option value="">Todos</option></select></div>
            <div class="col-lg-1 d-grid"><button class="btn btn-accent">Filtrar</button></div>
        </form>
    </div>
    <div class="table-card table-responsive">
        <table class="table align-middle mb-0">
            <thead><tr><th>Data</th><th>Cliente</th><th>Profissional</th><th>Serviço</th><th>Status</th><th class="text-end">Ações</th></tr></thead>
            <tbody>
            @if (!Model.Reservas.Any()) { <tr><td colspan="6" class="text-center py-5 text-secondary">Nenhuma reserva encontrada.</td></tr> }
            @foreach (var reserva in Model.Reservas)
            {
                <tr>
                    <td><strong>@reserva.DataHoraInicio.ToString("dd/MM/yyyy")</strong><br /><small>@reserva.DataHoraInicio.ToString("HH:mm") às @reserva.DataHoraFim.ToString("HH:mm")</small></td>
                    <td>@reserva.Cliente.Nome</td><td>@reserva.Profissional.Nome</td><td>@reserva.Servico.Nome</td>
                    <td><span class="status-pill status-@reserva.Status.ToString().ToLower()">@reserva.Status</span></td>
                    <td class="text-end">
                    @if (reserva.Status is not StatusReserva.Cancelada and not StatusReserva.Concluida)
                    {
                        <form asp-action="AlterarStatus" method="post" class="d-inline-flex gap-1">
                            <input type="hidden" name="id" value="@reserva.Id" />
                            <select name="status" class="form-select form-select-sm"><option value="Confirmada">Confirmada</option><option value="Concluida">Concluída</option><option value="Cancelada">Cancelada</option><option value="NaoCompareceu">Não compareceu</option></select>
                            <button class="btn btn-sm btn-outline-brand">Salvar</button>
                        </form>
                    }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</section>
