<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BarberFlow</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<header>
    <nav class="navbar navbar-expand-lg navbar-dark main-navbar sticky-top">
        <div class="container">
            <a class="navbar-brand brand-mark" asp-controller="Home" asp-action="Index">
                <span class="brand-icon">BF</span>
                <span>BarberFlow</span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menu">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="menu">
                <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-1">
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Início</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Servicos" asp-action="Index">Serviços</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Profissionais" asp-action="Index">Profissionais</a></li>
                    @if (User.IsInRole("Cliente"))
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Reservas" asp-action="Index">Minhas reservas</a></li>
                    }
                    @if (User.IsInRole("Profissional"))
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="AgendaProfissional" asp-action="Index">Minha agenda</a></li>
                    }
                    @if (User.IsInRole("Administrador"))
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">Administração</a>
                            <ul class="dropdown-menu shadow-sm">
                                <li><a class="dropdown-item" asp-controller="Admin" asp-action="Index">Visão geral</a></li>
                                <li><a class="dropdown-item" asp-controller="ProfissionaisAdmin" asp-action="Index">Profissionais</a></li>
                                <li><a class="dropdown-item" asp-controller="ServicosAdmin" asp-action="Index">Serviços</a></li>
                                <li><a class="dropdown-item" asp-controller="ReservasAdmin" asp-action="Index">Reservas</a></li>
                                <li><a class="dropdown-item" asp-controller="RelatoriosAdmin" asp-action="Index">Relatórios</a></li>
                            </ul>
                        </li>
                    }
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li class="nav-item dropdown ms-lg-2">
                            <a class="nav-link dropdown-toggle user-menu" href="#" role="button" data-bs-toggle="dropdown">
                                Olá, @User.Identity.Name
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                <li>
                                    <form asp-controller="Conta" asp-action="Sair" method="post">
                                        <button type="submit" class="dropdown-item">Sair</button>
                                    </form>
                                </li>
                            </ul>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item ms-lg-2"><a class="nav-link" asp-controller="Conta" asp-action="Login">Entrar</a></li>
                        <li class="nav-item"><a class="btn btn-accent btn-sm px-3 ms-lg-1" asp-controller="Conta" asp-action="Registro">Criar conta</a></li>
                    }
                </ul>
            </div>
        </div>
    </nav>
</header>
<partial name="_Alertas" />
<main role="main">@RenderBody()</main>
<footer class="site-footer mt-5">
    <div class="container py-4 d-flex flex-column flex-md-row justify-content-between gap-2">
        <span>© @DateTime.Now.Year BarberFlow</span>
        <span>Agendamento simples. Atendimento organizado.</span>
    </div>
</footer>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
document.addEventListener("click", function(e){ const button=e.target.closest(".confirm-action"); if(button && !confirm(button.dataset.message || "Confirmar esta ação?")){ e.preventDefault(); } });
setTimeout(() => document.querySelectorAll(".barber-toast").forEach(t => bootstrap.Toast.getOrCreateInstance(t).hide()), 4500);
</script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
