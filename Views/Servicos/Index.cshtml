@model IReadOnlyList<Servico>
@{
    ViewData["Title"] = "Serviços";
}
<div class="container py-5">
    <div class="admin-page-header mb-4">
        <div>
            <span class="eyebrow">ESCOLHA SEU ATENDIMENTO</span>
            <h1 class="fw-bold mt-2 mb-1">Serviços</h1>
            <p class="text-secondary mb-0">Consulte duração e preço e siga diretamente para o agendamento.</p>
        </div>
        @if (User.IsInRole("Cliente"))
        {
            <a class="btn btn-outline-brand" asp-controller="Reservas" asp-action="Index">Minhas reservas</a>
        }
    </div>

    <div class="row g-4">
        @foreach (var servico in Model)
        {
            <div class="col-md-6 col-xl-4">
                <div class="card h-100 shadow-sm service-card">
                    <div class="card-body d-flex flex-column">
                        <h2 class="h4">@servico.Nome</h2>
                        <p class="text-secondary flex-grow-1">@servico.Descricao</p>
                        <p class="mb-1"><strong>Duração:</strong> @servico.DuracaoMinutos minutos</p>
                        <p><strong>Preço:</strong> @servico.Preco.ToString("C")</p>
                        <div class="d-flex gap-2 flex-wrap mt-2">
                            <a class="btn btn-outline-brand" asp-action="Detalhes" asp-route-id="@servico.Id">Ver detalhes</a>
                            <a class="btn btn-accent" asp-controller="Reservas" asp-action="Nova" asp-route-servicoId="@servico.Id">Reservar</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
